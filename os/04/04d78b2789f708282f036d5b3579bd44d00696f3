{
  "name": "gltest",
  "category": "system",
  "summary": "GPU 3D test, stage 2: OpenGL through Mesa on the GPU (needs the GPU Drivers package)",
  "usage": "gltest",
  "engine": "pipeline",
  "steps": [
    { "if": "/linux/usr/bin/swirl-gltest.sh exists",
      "then": [
        { "print": "starting the OpenGL test (Mesa takes ~10 s to load)...", "color": "accent" },
        { "spawn": "/system/apps/lx", "arg": "/usr/bin/dash /usr/bin/swirl-gltest.sh", "follow": "/system/debug/gltest-log.txt" }
      ],
      "else": [
        { "print": "gltest needs the GPU Drivers package: spm install gpu-drivers (or Swirl Store).", "color": "err" },
        { "print": "Open the Store, update Web Browser, then run gltest again.", "color": "err" }
      ] }
  ]
}
