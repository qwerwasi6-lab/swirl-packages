{
  "name": "kill",
  "engine": "pipeline",
  "category": "system",
  "usage": "kill <pid>",
  "summary": "terminate a process",
  "args": [
    {
      "name": "pid"
    }
  ],
  "steps": [
    { "if": "$# < 1",
      "then": [ { "print": "usage: kill <pid>", "color": "err" } ],
      "else": [
        { "syscall": "kill", "args": ["$pid"], "as": "rc" },
        { "if": "$rc == 0",
          "then": [ { "print": "terminated", "color": "ok" } ],
          "else": [
            { "if": "$rc == -2",
              "then": [ { "print": "refused: protected process", "color": "err" } ],
              "else": [
                { "if": "$rc == -3",
                  "then": [ { "print": "refused: that is this shell's own process", "color": "err" } ],
                  "else": [ { "print": "no such process", "color": "err" } ] }
              ] }
          ] }
      ] }
]
}
