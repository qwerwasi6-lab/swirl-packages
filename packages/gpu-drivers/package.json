{
 "name": "gpu-drivers",
 "version": "1.0.2",
 "description": "Mesa GPU drivers (Intel crocus/iris and friends) and the SwirlOS GL server: 3D on your graphics chip.",
 "author": "Mesa, LLVM, libdrm and friends (Ubuntu 24.04 builds); SwirlOS GL server and libdrm patch by Swirl",
 "title": "GPU Drivers",
 "category": "Tools",
 "tagline": "Hardware 3D for apps, games and the browser.",
 "long": "Mesa 25.2 OpenGL drivers plus the SwirlOS GL server. Apps that draw 3D (3D Demo, games, the Web Browser) send their drawing to your graphics chip instead of the CPU.\\nThe server only runs while a 3D app is open and quits when it closes, so idle RAM stays the same.\\nSupported: Intel HD Graphics (Gen 4 to Gen 8, e.g. Bay Trail, Haswell, Broadwell). Terminal command gltest checks that it works.",
 "publisher": "Swirl",
 "license": "MIT / LGPL / Apache-2.0 (Ubuntu packages)",
 "color": "7A4FD6",
 "glyph": "tool",
