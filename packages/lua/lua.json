{
  "name": "lua",
  "category": "custom",
  "summary": "run Lua scripts, or start an interactive prompt",
  "usage": "lua -run <file.lua> [args...]   |   lua -e <code>   |   lua -i   |   lua -v",
  "engine": "pipeline",
  "steps": [
    { "spawn": "/home/user/Apps/lua/lua.elf", "arg": "--cwd=$CWD --in=/home/user/.lua.in $@", "follow": "/home/user/.lua.out", "stdin": "/home/user/.lua.in" }
  ]
}
